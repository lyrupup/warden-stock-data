# 统一环境变量（go 与 python 服务、Docker 部署共用本文件）
# 首次使用：cp .env.example .env 并按环境修改
#
# 本地开发：
#   - 基建：cd backend/go && make infra-up（仅 postgres + redis 容器）
#   - go：  cd backend/go && make run（本机直跑，自动加载本文件）
#   - python：cd backend/python && make run（本机直跑，自动加载本文件）
# Docker 全量部署：cd backend/deploy && ./deploy.sh
#   （compose 读取本文件；容器内 PG_HOST/REDIS_HOST/QUANT_BASE_URL 自动覆盖为服务名）

APP_PORT=8080
APP_ENV=dev

JWT_SECRET=change_me_dev_only
CONFIG_ENC_KEY=32_bytes_key_for_aes_gcm________

# PostgreSQL（本地 PG_HOST=localhost；Docker 部署时 compose 覆盖为 postgres）
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=warden_data
PG_SSLMODE=disable

# Redis（本地 REDIS_HOST=localhost；Docker 部署时 compose 覆盖为 redis）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 行情源（gotdx：分时/快照/指数；日K 由 python/baostock 采集）
MARKET_PROVIDER=gotdx

# Python quant 服务（采集 + 指标；仅 go 内网调用）
# 本地 QUANT_BASE_URL=http://127.0.0.1:8000；Docker 部署时 compose 覆盖为 http://quant:8000
QUANT_BASE_URL=http://127.0.0.1:8000
QUANT_PORT=8000
QUANT_ENV=dev
# go 调用 python 内部接口携带的共享密钥（两侧必须一致）
INTERNAL_TOKEN=change_me_internal_token
# python 采集参数
COLLECT_BAOSTOCK_RETRY=3
# 全量回补起始日；1990-12-19 为 A 股最早交易日（=回补每只股票自上市以来全部历史）。
# baostock start_date 留空会默认从 2015-01-01 开始，故需显式指定早日期才能拿全量。
BACKFILL_START_DATE=1990-12-19

# 默认管理员（首次启动写入 DB）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
