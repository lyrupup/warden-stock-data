# 后端统一环境变量（本地 Go 开发与 Docker 部署共用本文件）
# 首次使用：cp .env.example .env 并按环境修改
#
# 本地开发：cd backend && make run（自动加载本文件）
# Docker 部署：cd backend/deploy && ./deploy.sh（compose 读取本文件；容器内 PG_HOST/REDIS_HOST 自动覆盖为服务名）

APP_PORT=8080
APP_ENV=dev

JWT_SECRET=change_me_dev_only
CONFIG_ENC_KEY=32_bytes_key_for_aes_gcm________

# PostgreSQL（本地 PG_HOST=localhost；Docker 部署时 compose 覆盖为 postgres）
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=warden_data
PG_SSLMODE=disable

# Redis（本地 REDIS_HOST=localhost；Docker 部署时 compose 覆盖为 redis）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 行情源（仅支持 gotdx）
MARKET_PROVIDER=gotdx

# 默认管理员（首次启动写入 DB）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
